# .env.example — copy to .env for local development
# NEVER commit .env to git

CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change_me_strong_password
CLICKHOUSE_DB=analytics

# Comma-separated list of valid HMAC-SHA256 API keys per service
ANALYTICS_API_KEYS=key_user_a,key_user_vip,demo-key-123
BRANDING_API_KEYS=key_user_b,key_user_vip

# Grafana admin password (override in .env for non-local use)
GRAFANA_ADMIN_PASSWORD=admin
