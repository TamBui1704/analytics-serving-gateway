# k8s/secret.yaml.example
# File mẫu Secret (TEMPLATE - KHÔNG CHỨA KEY THẬT)
#
# HƯỚNG DẪN TẠO SECRET CHO LOCAL / DEV:
#
# Cách tốt nhất: Tạo trực tiếp bằng lệnh kubectl CLI (không lưu ra file để tránh lộ Git):
#   kubectl create secret generic analytics-gateway-secret \
#     --from-literal=ANALYTICS_API_KEYS="key_user_a,key_user_vip,demo-key-123" \
#     --from-literal=BRANDING_API_KEYS="key_user_b,key_user_vip" \
#     --from-literal=CLICKHOUSE_HOST="localhost" \
#     --from-literal=CLICKHOUSE_PASSWORD="" \
#     -n analytics \
#     --dry-run=client -o yaml | kubectl apply -f -
#
# Hoặc copy file này thành k8s/secret.yaml (file này đã được .gitignore bỏ qua):
#   cp k8s/secret.yaml.example k8s/secret.yaml
#   # Điền base64 key thật vào k8s/secret.yaml rồi apply:
#   kubectl apply -f k8s/secret.yaml -n analytics

apiVersion: v1
kind: Secret
metadata:
  name: analytics-gateway-secret
  namespace: analytics
  labels:
    app: analytics-api
type: Opaque
data:
  # echo -n "key_user_a,key_user_vip,demo-key-123" | base64
  ANALYTICS_API_KEYS: a2V5X3VzZXJfYSxrZXlfdXNlcl92aXAsZGVtby1rZXktMTIz
  # echo -n "key_user_b,key_user_vip" | base64
  BRANDING_API_KEYS: a2V5X3VzZXJfYixrZXlfdXNlcl92aXA=
  # echo -n "localhost" | base64  → use host.minikube.internal in Minikube
  CLICKHOUSE_HOST: bG9jYWxob3N0
  # echo -n "" | base64  → empty password for local dev
  CLICKHOUSE_PASSWORD: ""

